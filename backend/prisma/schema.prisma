generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  email       String   @unique
  phone       String?
  website     String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  /// Pengaturan company, mis. { sla: { firstResponseMinutes, resolutionHours } }
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  channels         Channel[]
  contacts         Contact[]
  conversations    Conversation[]
  labels           Label[]
  auditLogs        AuditLog[]
  posts            Post[]
  aiAgents         AiAgent[]
  aiKnowledge      AiKnowledge[]
  aiKnowledgeMedia AiKnowledgeMedia[]
  aiMedia          AiMedia[]
  broadcasts       Broadcast[]
  pipelines        Pipeline[]
  deals            Deal[]

  @@index([slug])
  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  email        String
  password     String
  role         UserRole @default(AGENT)
  avatar       String?
  isActive     Boolean  @default(true)
  refreshToken String?  @db.Text
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments   Assignment[]
  sentMessages  Message[]      @relation("SentMessages")
  auditLogs     AuditLog[]
  ownedDeals    Deal[]         @relation("DealOwner")

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@map("users")
}

model Channel {
  id            String      @id @default(uuid())
  companyId     String
  type          ChannelType
  name          String
  isActive      Boolean     @default(true)
  wabaId        String?
  phoneNumberId String?
  accessToken   String?     @db.Text
  verifyToken   String?
  webhookUrl    String?
  metadata      Json?
  sessionData   String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  posts         Post[]
  broadcasts    Broadcast[]

  @@index([companyId])
  @@index([type])
  @@map("channels")
}

model Contact {
  id               String   @id @default(uuid())
  companyId        String
  name             String
  phone            String?
  email            String?
  avatar           String?
  sourceChannel    String?
  firstContactDate DateTime @default(now())
  totalMessages    Int      @default(0)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  broadcastRecipients BroadcastRecipient[]
  deals         Deal[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([phone])
  @@map("contacts")
}

model Conversation {
  id          String             @id @default(uuid())
  companyId   String
  channelId   String
  contactId   String
  status      ConversationStatus @default(OPEN)
  isRead      Boolean            @default(false)
  lastMessage String?            @db.Text
  lastMessageAt DateTime?
  /// Balasan pertama ke pelanggan (AI / agen / HP), bukan broadcast.
  firstResponseAt DateTime?
  closedAt    DateTime?
  closedById  String?
  /// AI | HUMAN — siapa yang menangani. HUMAN menimpa AI saat manusia membalas.
  handledBy   String?
  /// Balasan manusia pertama (serah terima AI → agen), untuk durasi sesi AI vs agen.
  handedToHumanAt DateTime?
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel     Channel              @relation(fields: [channelId], references: [id])
  contact     Contact              @relation(fields: [contactId], references: [id])
  messages    Message[]
  labels      ConversationLabel[]
  assignments Assignment[]

  @@index([companyId])
  @@index([channelId])
  @@index([contactId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([createdAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String?
  direction      Direction
  type           MessageType @default(TEXT)
  content        String?     @db.Text
  mediaUrl       String?
  mediaType      String?
  fileName       String?
  fileSize       Int?
  wamid          String?     @unique
  status         MessageStatus @default(SENT)
  isRead         Boolean     @default(false)
  reactionEmoji  String?
  metadata       Json?
  sentAt         DateTime    @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?         @relation("SentMessages", fields: [senderId], references: [id])
  attachments  Attachment[]

  @@index([conversationId])
  @@index([senderId])
  @@index([wamid])
  @@index([sentAt])
  @@map("messages")
}

model Label {
  id        String   @id @default(uuid())
  companyId String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations ConversationLabel[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("labels")
}

model ConversationLabel {
  conversationId String
  labelId        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@map("conversation_labels")
}

model Assignment {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  assignedAt     DateTime @default(now())
  unassignedAt   DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([userId])
  @@map("assignments")
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  url       String
  type      String
  name      String?
  size      Int?
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

model Post {
  id           String       @id @default(uuid())
  companyId    String
  channelId    String?
  platform     PostPlatform @default(INSTAGRAM)
  mediaUrls    Json?
  caption      String?      @db.Text
  scheduledAt  DateTime?
  publishedAt  DateTime?
  status       PostStatus   @default(DRAFT)
  igContainerId String?
  igMediaId    String?
  permalink    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([scheduledAt])
  @@map("posts")
}

enum PostPlatform {
  INSTAGRAM
  TIKTOK
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AiAgent {
  id           String     @id @default(uuid())
  companyId    String
  name         String
  description  String?    @db.Text
  provider     AiProvider
  model        String
  apiKey       String     @db.Text
  systemPrompt String?    @db.Text
  // Perilaku AI
  welcomeMessage        String? @db.Text
  communicationStyle    String? @db.Text
  conversationFlow      String? @db.Text
  communicationRules    String? @db.Text
  /// Array JSON: [{ id, content, pipeline }]. pipeline kosong = semua pelanggan.
  additionalInstructions Json?
  version      Int        @default(1)
  temperature  Float      @default(0.7)
  maxTokens    Int        @default(1024)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  knowledge AiKnowledge[]
  media     AiMedia[]

  @@index([companyId])
  @@map("ai_agents")
}

model AiKnowledge {
  id        String   @id @default(uuid())
  companyId String
  aiAgentId String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aiAgent AiAgent @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  media   AiKnowledgeMedia[]

  @@index([companyId])
  @@index([aiAgentId])
  @@map("ai_knowledge")
}

/// Gambar yang menempel pada satu entri Knowledge Base. Dipakai RAG sebagai
/// konteks media dan dikirim AI Agent lewat channel (WhatsApp, dsb).
model AiKnowledgeMedia {
  id          String   @id @default(uuid())
  companyId   String
  knowledgeId String
  filename    String
  mimeType    String
  fileSize    Int
  storagePath String
  publicUrl   String   @db.Text
  altText     String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  knowledge AiKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([knowledgeId])
  @@map("ai_knowledge_media")
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  GROQ
}

model AiMedia {
  id          String         @id @default(uuid())
  companyId   String
  aiAgentId   String
  title       String
  mediaUrl    String         @db.Text
  caption     String?        @db.Text
  description String?        @db.Text
  keywords    String?        @db.Text
  trigger     AiMediaTrigger @default(KEYWORD)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aiAgent AiAgent @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([aiAgentId])
  @@map("ai_media")
}

enum AiMediaTrigger {
  KEYWORD
  AI
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum ChannelType {
  WHATSAPP
  WHATSAPP_UNOFFICIAL
  INSTAGRAM
  FACEBOOK
  TIKTOK
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  REACTION
  TEMPLATE
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// Campaign broadcast (Broadcast Protection & Compliance Engine).
/// status: DRAFT | SCHEDULED | RUNNING | PAUSED | COMPLETED | CANCELLED
model Broadcast {
  id              String    @id @default(uuid())
  companyId       String
  channelId       String
  createdById     String?
  name            String
  message         String    @db.Text
  mediaUrl        String?   @db.Text
  status          String    @default("DRAFT")
  /// Filter audiens: { consent, labelIds, sourceChannel, activeWithinDays, includeReview }
  audience        Json?
  /// Proteksi: { quietStart, quietEnd, minDelaySec, maxDelaySec, dailyLimit, frequencyCapHours, autoPause, ... }
  settings        Json?
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  pauseReason     String?   @db.Text
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  skippedCount    Int       @default(0)
  repliedCount    Int       @default(0)
  optOutCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel    Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  recipients BroadcastRecipient[]

  @@index([companyId])
  @@index([status])
  @@map("broadcasts")
}

/// status: PENDING | SENT | FAILED | SKIPPED
model BroadcastRecipient {
  id          String    @id @default(uuid())
  broadcastId String
  contactId   String
  phone       String
  name        String
  status      String    @default("PENDING")
  error       String?   @db.Text
  attempts    Int       @default(0)
  sentAt      DateTime?
  repliedAt   DateTime?
  optedOutAt  DateTime?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, contactId])
  @@index([contactId, sentAt])
  @@index([broadcastId, status])
  @@map("broadcast_recipients")
}

/// Pipeline CRM (papan Kanban). autoMode: AUTO | SUGGEST | MANUAL
model Pipeline {
  id              String   @id @default(uuid())
  companyId       String
  name            String
  isDefault       Boolean  @default(false)
  autoMode        String   @default("AUTO")
  /// Kontak baru yang chat pertama kali otomatis dibuatkan deal di tahap awal.
  autoCreateDeals Boolean  @default(true)
  /// Deal tanpa aktivitas selama N hari dipindah ke tahap kalah (0 = nonaktif).
  lostAfterDays   Int      @default(7)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages  PipelineStage[]
  deals   Deal[]

  @@index([companyId])
  @@map("pipelines")
}

/// kind: OPEN | WON | LOST. autoRule: FIRST_CHAT | REPLIED | INTEREST | PAYMENT_SENT (opsional)
model PipelineStage {
  id         String  @id @default(uuid())
  pipelineId String
  name       String
  color      String  @default("#18a6fc")
  position   Int
  kind       String  @default("OPEN")
  autoRule   String?
  /// Definisi tahap untuk AI (kapan pelanggan dianggap berada di tahap ini).
  aiHint     String? @db.Text

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId])
  @@map("pipeline_stages")
}

/// status: OPEN | WON | LOST
model Deal {
  id              String    @id @default(uuid())
  companyId       String
  pipelineId      String
  stageId         String
  contactId       String
  ownerId         String?
  title           String
  value           Int       @default(0)
  status          String    @default("OPEN")
  lostReason      String?
  expectedCloseAt DateTime?
  stageEnteredAt  DateTime  @default(now())
  lastActivityAt  DateTime  @default(now())
  wonAt           DateTime?
  lostAt          DateTime?
  /// Saran AI yang menunggu konfirmasi: { stageId, confidence, reason, evidence, at }
  aiSuggestion    Json?
  /// Dipindah manual → AI tidak memindahkan otomatis sampai waktu ini.
  aiLockedUntil   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipeline   Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      PipelineStage  @relation(fields: [stageId], references: [id])
  contact    Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner      User?          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities DealActivity[]

  @@index([companyId, status])
  @@index([pipelineId, stageId])
  @@index([contactId])
  @@map("deals")
}

/// type: CREATED | STAGE | UPDATE | NOTE | SUGGESTION. actor: SYSTEM | AI | USER
model DealActivity {
  id          String   @id @default(uuid())
  dealId      String
  type        String
  actor       String
  userId      String?
  fromStageId String?
  toStageId   String?
  message     String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
  @@map("deal_activities")
}
